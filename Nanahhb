-- Chạm để bật/tắt menu; kéo để di chuyển nút
local dragging = false
local moved = false
local startPosition
local startPoint
local activeTouch
local mouseHeld = false

local function moveToggle(point)
    local delta = point - startPoint

    if delta.Magnitude > 8 then
        moved = true
    end

    if moved then
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize
        local size = toggle.AbsoluteSize

        local x = math.clamp(
            startPosition.X.Offset + delta.X,
            0, (viewport and viewport.X or 800) - size.X
        )
        local y = math.clamp(
            startPosition.Y.Offset + delta.Y,
            0, (viewport and viewport.Y or 600) - size.Y
        )

        toggle.Position = UDim2.fromOffset(x, y)
    end
end

toggle.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        moved = false
        activeTouch = i
        startPoint = i.Position
        startPosition = toggle.Position

    elseif i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        mouseHeld = true
        moved = false
        startPoint = i.Position
        startPosition = toggle.Position
    end
end)

UIS.InputChanged:Connect(function(i)
    if not dragging then return end

    if i.UserInputType == Enum.UserInputType.Touch
        and i == activeTouch then
        moveToggle(i.Position)

    elseif i.UserInputType == Enum.UserInputType.MouseMovement
        and mouseHeld then
        moveToggle(i.Position)
    end
end)

UIS.InputEnded:Connect(function(i)
    local finishedTouch =
        i.UserInputType == Enum.UserInputType.Touch
        and i == activeTouch

    local finishedMouse =
        i.UserInputType == Enum.UserInputType.MouseButton1
        and mouseHeld

    if not finishedTouch and not finishedMouse then
        return
    end

    dragging = false
    mouseHeld = false
    activeTouch = nil

    if not moved then
        main.Visible = not main.Visible
    end
end)

-- PHÁT NHẠC: ON / OFF / ON LẠI
local lastId = ""

on.Activated:Connect(function()
    local typedId = input.Text:match("^%s*(%d+)%s*$")

    if typedId then
        lastId = typedId
    end

    if lastId == "" then
        status.Text = "⚠ Hãy nhập Sound ID!"
        return
    end

    sound:Stop()
    sound.SoundId = "rbxassetid://" .. lastId
    sound.Looped = true
    sound.TimePosition = 0

    local ok = pcall(function()
        sound:Play()
    end)

    if ok then
        status.Text = "▶ Đang phát nhạc lặp lại ♡"
    else
        status.Text = "⚠ Không thể phát nhạc"
    end
end)

off.Activated:Connect(function()
    sound:Stop()
    status.Text = "■ Đã tắt nhạc ♡"
end)

-- KÉO MENU CHÍNH BẰNG THANH TIÊU ĐỀ
local menuDragging = false
local menuStartPoint
local menuStartPosition
local menuTouch

header.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch then
        menuDragging = true
        menuTouch = i
        menuStartPoint = i.Position
        menuStartPosition = main.Position
    elseif i.UserInputType == Enum.UserInputType.MouseButton1 then
        menuDragging = true
        menuStartPoint = i.Position
        menuStartPosition = main.Position
    end
end)

UIS.InputChanged:Connect(function(i)
    if not menuDragging then return end

    local validTouch = i.UserInputType == Enum.UserInputType.Touch
        and i == menuTouch
    local validMouse = i.UserInputType == Enum.UserInputType.MouseMovement
        and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)

    if validTouch or validMouse then
        local delta = i.Position - menuStartPoint
        main.Position = UDim2.new(
            menuStartPosition.X.Scale,
            menuStartPosition.X.Offset + delta.X,
            menuStartPosition.Y.Scale,
            menuStartPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch
        and i == menuTouch then
        menuDragging = false
        menuTouch = nil
    elseif i.UserInputType == Enum.UserInputType.MouseButton1 then
        menuDragging = false
    end
end)
